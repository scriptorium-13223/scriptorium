# ── Server ──
NODE_ENV=production
PORT=4000

# Comma-separated list of allowed frontend origins (your GitHub Pages URL)
ALLOWED_ORIGINS=https://yourusername.github.io

# ── Supabase (Free Plan) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=assignment-uploads

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenHere
TELEGRAM_CHAT_ID=123456789

# ── Admin Panel (single shared secret, no user accounts) ──
ADMIN_SECRET=choose-a-strong-password-here

# ── Uploads ──
MAX_UPLOAD_SIZE_MB=20
